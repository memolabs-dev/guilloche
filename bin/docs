#!/usr/bin/env php
<?php
//
// docs — genere docs/COMPONENTS.generated.md depuis les manifests et les
// templates du kit. Le fichier produit est verifie par la CI : il ne doit
// jamais diverger des sources.
declare(strict_types=1);

const ROOT = __DIR__ . '/..';
const KITS = ROOT . '/kits/guilloche';
const OUT = ROOT . '/docs/COMPONENTS.generated.md';

const FAMILIES = [
    'fondation' => 'Fondation',
    'layout' => 'Mise en page',
    'signature' => 'Signature',
    'primitives' => 'Primitives',
    'formulaires' => 'Formulaires',
    'navigation' => 'Navigation et surfaces',
    'donnees' => 'Donnees',
    'patterns' => 'Patterns d\'ecran',
    'avances' => 'Composants avances',
];

/** Premiere phrase du README, apres le titre. */
function description(string $dir): string
{
    $readme = $dir . '/README.md';
    if (!is_file($readme)) {
        return '';
    }
    foreach (explode("\n", (string) file_get_contents($readme)) as $line) {
        $line = trim($line);
        if ('' === $line || str_starts_with($line, '#')) {
            continue;
        }
        return rtrim($line, '.');
    }

    return '';
}

/**
 * Sépare les déclarations Twig seulement sur les virgules de premier niveau.
 * Une valeur par défaut peut elle-même contenir tableaux, hashes, appels ou
 * textes avec virgules : ils ne créent pas de nouvelles props.
 */
function parsePropNames(string $declaration): array
{
    $parts = [];
    $part = '';
    $stack = [];
    $quote = null;
    $escaped = false;

    for ($i = 0, $length = strlen($declaration); $i < $length; ++$i) {
        $char = $declaration[$i];

        if (null !== $quote) {
            $part .= $char;
            if ($escaped) {
                $escaped = false;
            } elseif ('\\' === $char) {
                $escaped = true;
            } elseif ($char === $quote) {
                $quote = null;
            }
            continue;
        }

        if ("'" === $char || '"' === $char) {
            $quote = $char;
            $part .= $char;
            continue;
        }

        if (in_array($char, ['[', '{', '('], true)) {
            $stack[] = $char;
            $part .= $char;
            continue;
        }

        if (in_array($char, [']', '}', ')'], true)) {
            array_pop($stack);
            $part .= $char;
            continue;
        }

        if (',' === $char && [] === $stack) {
            $parts[] = trim($part);
            $part = '';
            continue;
        }

        $part .= $char;
    }

    $parts[] = trim($part);
    $names = [];
    foreach ($parts as $definition) {
        if (preg_match('/^([a-zA-Z_][a-zA-Z0-9_]*)(?:\s*=|$)/', $definition, $match)) {
            $names[] = $match[1];
        }
    }

    return $names;
}

/** Noms des props declarees dans le template principal du composant. */
function props(string $dir): array
{
    $templates = glob($dir . '/templates/components/*.html.twig') ?: [];
    if (!$templates) {
        return [];
    }
    $twig = (string) file_get_contents($templates[0]);
    if (!preg_match('/\{%\s*props\s+(.+?)%\}/s', $twig, $match)) {
        return [];
    }

    return parsePropNames(trim($match[1]));
}

// Test rapide, sans dépendances ni écriture dans le catalogue généré.
if (in_array('--self-test', $argv ?? [], true)) {
    $cases = [
        "label = 'Bonjour, humain', disabled = false" => ['label', 'disabled'],
        "weekdays = ['L', 'M', 'M', 'J', 'V', 'S', 'D'], value = null" => ['weekdays', 'value'],
        'options = { fields: [1, 2], nested: { a: 1, b: 2 } }, label = null' => ['options', 'label'],
        'seed, size = 32, progress = null' => ['seed', 'size', 'progress'],
        "name = 'l\\'objet, verifie', required = true" => ['name', 'required'],
    ];
    foreach ($cases as $declaration => $expected) {
        $actual = parsePropNames($declaration);
        if ($actual !== $expected) {
            fwrite(STDERR, sprintf("Échec du parseur pour %s : attendu %s, reçu %s\n", $declaration, json_encode($expected), json_encode($actual)));
            exit(1);
        }
    }
    echo sprintf("Parseur des props Twig : %d cas validés.\n", count($cases));
    exit(0);
}

$recipes = [];
foreach (glob(KITS . '/*/manifest.json') ?: [] as $manifestPath) {
    $dir = dirname($manifestPath);
    $data = json_decode((string) file_get_contents($manifestPath), true) ?: [];
    $recipes[] = [
        'name' => basename($dir),
        'dir' => $dir,
        'family' => (string) ($data['family'] ?? 'primitives'),
        'version' => (string) ($data['version-added'] ?? ''),
        'description' => description($dir),
        'props' => props($dir),
    ];
}

usort($recipes, static fn (array $a, array $b): int => $a['name'] <=> $b['name']);

$lines = [
    '# Catalogue genere',
    '',
    'Fichier genere par `bin/docs` depuis les manifests et les templates du kit.',
    'Ne pas editer a la main : la CI verifie qu\'il correspond aux sources.',
    '',
];

foreach (FAMILIES as $key => $label) {
    $group = array_values(array_filter($recipes, static fn (array $r): bool => $r['family'] === $key));
    if (!$group) {
        continue;
    }
    $lines[] = '## ' . $label;
    $lines[] = '';
    $lines[] = '| Recette | Version | Props | Description |';
    $lines[] = '|---|---|---|---|';
    foreach ($group as $recipe) {
        $lines[] = sprintf(
            '| `%s` | %s | %s | %s |',
            $recipe['name'],
            $recipe['version'],
            $recipe['props'] ? implode(', ', array_map(static fn (string $p): string => '`' . $p . '`', $recipe['props'])) : 'aucune',
            $recipe['description'],
        );
    }
    $lines[] = '';
}

file_put_contents(OUT, implode("\n", $lines));
echo sprintf("Catalogue genere : %s (%d recettes)%s", OUT, count($recipes), PHP_EOL);
