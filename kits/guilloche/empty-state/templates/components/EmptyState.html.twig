{# Ui:EmptyState — état vide et action, textes fournis par l'application.
   Filigrane opt-in, en contre-jour et uniquement en thème sombre. #}
{% props title, message = null, watermark = false, watermarkPath = null %}
<div {{ attributes.defaults({ class: 'ui-empty-state' ~ (watermark ? ' ui-empty-state--watermark' : '') }) }}>
  {% if watermark %}
    <svg class="ui-empty-state__watermark" aria-hidden="true" focusable="false" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="0.9">
      {% if watermarkPath %}
        <path d="{{ watermarkPath }}" />
      {% else %}
        <g transform="translate(50 50) scale(0.53)">
          {% for rotation in [0, 30, 60, 90, 120, 150] %}
            <ellipse cx="0" cy="0" rx="91" ry="34" transform="rotate({{ rotation }})" />
          {% endfor %}
          <circle cx="0" cy="0" r="92" />
        </g>
      {% endif %}
    </svg>
  {% endif %}
  <p class="ui-empty-state__title">{{ title }}</p>
  {% if message %}<p class="ui-empty-state__message">{{ message }}</p>{% endif %}
  {% block content %}{% endblock %}
</div>
