{# Ui:Dialog — boite modale native. Le composant englobe son bouton d'ouverture
   et le dialogue pour que le controleur ui--dialog les relie. trigger est le
   libelle du bouton, title le titre du dialogue ; le slot est le contenu. #}
{% props id, title, trigger = null, description = null, closeLabel = 'Fermer' %}
<div class="ui-dialog-root" data-controller="ui--dialog">
  {% if trigger %}
    <button class="ui-dialog__trigger" type="button" data-action="ui--dialog#open">{{ trigger }}</button>
  {% endif %}
  <dialog class="ui-dialog" id="{{ id }}" aria-labelledby="{{ id }}-title"{% if description %} aria-describedby="{{ id }}-description"{% endif %} data-ui--dialog-target="dialog" data-action="click->ui--dialog#backdrop">
    <div class="ui-dialog__panel">
      <header class="ui-dialog__header">
        <div>
          <h2 class="ui-dialog__title" id="{{ id }}-title">{{ title }}</h2>
          {% if description %}<p class="ui-dialog__description" id="{{ id }}-description">{{ description }}</p>{% endif %}
        </div>
        <button class="ui-dialog__close" type="button" data-action="ui--dialog#close" aria-label="{{ closeLabel }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m6.5 6.5 11 11M6.5 17.5l11-11"/></svg>
        </button>
      </header>
      <div class="ui-dialog__body">{% block content %}{% endblock %}</div>
    </div>
  </dialog>
</div>
