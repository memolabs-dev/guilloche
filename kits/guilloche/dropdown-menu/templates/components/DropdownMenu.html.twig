{# Ui:DropdownMenu — menu d'actions ou de liens. Repose sur details et summary :
   ouverture, clavier et fermeture fonctionnent sans JavaScript. items : liste de
   { label, href }. #}
{% props label, items = [] %}
<details {{ attributes.defaults({ class: 'ui-dropdown' }) }}>
  <summary class="ui-dropdown__trigger">
    <span>{{ label }}</span>
    <svg class="ui-dropdown__chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9.5 6 6 6-6"/></svg>
  </summary>
  <div class="ui-dropdown__menu">
    {% for item in items %}
      <a class="ui-dropdown__item" href="{{ item.href ?? '#' }}">{{ item.label }}</a>
    {% endfor %}
  </div>
</details>
