{% extends 'base.html.twig' %}

{% block title %}Guilloche, design system{% endblock %}

{% block body %}
<div class="ds">
  <aside class="ds__rail">
    <p class="ds__brand">guilloché<span>.</span></p>
    <p class="ds__version">design system · 1.9.0</p>
    <nav class="ds__nav" aria-label="Sommaire">
      <a href="#fondations">Fondations</a>
      <a href="#actions">Actions</a>
      <a href="#formulaires">Formulaires</a>
      <a href="#navigation">Navigation</a>
      <a href="#surfaces">Surfaces</a>
      <a href="#donnees">Donnees</a>
      <a href="#mise-en-page">Mise en page</a>
      <a href="#avances">Composants avances</a>
      <a href="#en-situation">En situation</a>
    </nav>
  </aside>

  <main class="ds__main">
    <header class="ds__header">
      <h1 class="ds__title">Guilloche</h1>
      <p class="ds__lead">Design system natif Symfony pour les applications metier : composants Twig, tokens CSS et controleurs Stimulus, distribues par le Symfony UX Toolkit. Chaque example ci-dessous est rendu par le composant lui-meme, jamais par une capture.</p>
    </header>

    <section class="ds__section" id="fondations">
      <h2 class="ds__section-title">Fondations</h2>

      <div class="ds__block ds__block--wide">
        <div class="ds__block-head">
          <h3 class="ds__block-title">Couleurs</h3>
          <span class="ds__block-note">theme</span>
        </div>
        <div class="ds__swatches">
          <div class="ds__swatch"><span class="ds__swatch-color" style="background:#edf1ea"></span><span class="ds__swatch-name">background</span></div>
          <div class="ds__swatch"><span class="ds__swatch-color" style="background:#fbfcf9"></span><span class="ds__swatch-name">card</span></div>
          <div class="ds__swatch"><span class="ds__swatch-color" style="background:#14261b"></span><span class="ds__swatch-name">foreground</span></div>
          <div class="ds__swatch"><span class="ds__swatch-color" style="background:#376b44"></span><span class="ds__swatch-name">primary</span></div>
          <div class="ds__swatch"><span class="ds__swatch-color" style="background:#8c4810"></span><span class="ds__swatch-name">warning</span></div>
          <div class="ds__swatch"><span class="ds__swatch-color" style="background:#29497a"></span><span class="ds__swatch-name">info</span></div>
          <div class="ds__swatch"><span class="ds__swatch-color" style="background:#2a6237"></span><span class="ds__swatch-name">success</span></div>
          <div class="ds__swatch"><span class="ds__swatch-color" style="background:#a02f29"></span><span class="ds__swatch-name">danger</span></div>
        </div>
      </div>

      <div class="ds__block ds__block--wide">
        <div class="ds__block-head">
          <h3 class="ds__block-title">Typographie</h3>
          <span class="ds__block-note">Bodoni Moda Variable · Inter · Fira Code</span>
        </div>
        <div class="ds__type-row"><span class="ds__type-label">display</span><h1 class="ui-heading-1">Le titre guilloché.</h1></div>
        <div class="ds__type-row"><span class="ds__type-label">h2</span><h2 class="ui-heading-2">Une section de contenu</h2></div>
        <div class="ds__type-row"><span class="ds__type-label">texte</span><p>Le corps de texte utilise Inter a 14 px, avec une hauteur de ligne de 1,6. Les chiffres et le code passent en Fira Code.</p></div>
      </div>
    </section>

    <section class="ds__section" id="actions">
      <h2 class="ds__section-title">Actions</h2>
      <div class="ds__grid">
        <div class="ds__block ds__block--wide" data-recipe="button">
          <div class="ds__block-head"><h3 class="ds__block-title">Button</h3><span class="ds__block-note">ui:Button</span></div>
          <div class="ds__specimen">
            <twig:ui:Button intent="primary">Action principale</twig:ui:Button>
            <twig:ui:Button intent="secondary">Secondaire</twig:ui:Button>
            <twig:ui:Button intent="outline">Contour</twig:ui:Button>
            <twig:ui:Button intent="ghost">Discret</twig:ui:Button>
            <twig:ui:Button intent="danger">Supprimer</twig:ui:Button>
            <twig:ui:Button loading>Enregistrement</twig:ui:Button>
            <twig:ui:Button disabled>Desactive</twig:ui:Button>
          </div>
          <div class="ds__specimen">
            <twig:ui:Button size="sm">Petit</twig:ui:Button>
            <twig:ui:Button size="md">Moyen</twig:ui:Button>
            <twig:ui:Button size="lg">Grand</twig:ui:Button>
          </div>
        </div>

        <div class="ds__block" data-recipe="toggle">
          <div class="ds__block-head"><h3 class="ds__block-title">Toggle</h3><span class="ds__block-note">ui:Toggle</span></div>
          <div class="ds__specimen">
            <twig:ui:Toggle :pressed="true">Favoris</twig:ui:Toggle>
            <twig:ui:Toggle>Archive</twig:ui:Toggle>
          </div>
        </div>

        <div class="ds__block" data-recipe="toggle-group">
          <div class="ds__block-head"><h3 class="ds__block-title">ToggleGroup</h3><span class="ds__block-note">ui:ToggleGroup</span></div>
          <div class="ds__specimen">
            <twig:ui:ToggleGroup label="Affichage">
              <twig:ui:Toggle :pressed="true">Liste</twig:ui:Toggle>
              <twig:ui:Toggle>Grille</twig:ui:Toggle>
            </twig:ui:ToggleGroup>
          </div>
        </div>

        <div class="ds__block" data-recipe="button-group">
          <div class="ds__block-head"><h3 class="ds__block-title">ButtonGroup</h3><span class="ds__block-note">ui:ButtonGroup</span></div>
          <div class="ds__specimen">
            <twig:ui:ButtonGroup label="Alignement">
              <twig:ui:Button appearance="secondary">Gauche</twig:ui:Button>
              <twig:ui:Button appearance="secondary">Centre</twig:ui:Button>
              <twig:ui:Button appearance="secondary">Droite</twig:ui:Button>
            </twig:ui:ButtonGroup>
          </div>
        </div>

        <div class="ds__block" data-recipe="kbd">
          <div class="ds__block-head"><h3 class="ds__block-title">Kbd</h3><span class="ds__block-note">ui:Kbd</span></div>
          <div class="ds__specimen"><twig:ui:Kbd>Ctrl</twig:ui:Kbd> + <twig:ui:Kbd>K</twig:ui:Kbd></div>
        </div>

        <div class="ds__block" data-recipe="spinner">
          <div class="ds__block-head"><h3 class="ds__block-title">Spinner</h3><span class="ds__block-note">ui:Spinner</span></div>
          <div class="ds__specimen">
            <twig:ui:Spinner label="Chargement" />
            <twig:ui:Spinner size="lg" />
          </div>
        </div>
      </div>
    </section>

    <section class="ds__section" id="formulaires">
      <h2 class="ds__section-title">Formulaires</h2>
      <div class="ds__grid">
        <div class="ds__block" data-recipe="field">
          <div class="ds__block-head"><h3 class="ds__block-title">Field et Input</h3><span class="ds__block-note">ui:Field · ui:Input</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:Field id="demo-input" label="Rechercher" help="Nom ou categorie" required>
              <twig:ui:Input id="demo-input" describedBy="demo-input-help" required />
            </twig:ui:Field>
            <twig:ui:Field id="demo-input-error" label="Adresse e-mail" error="Adresse invalide">
              <twig:ui:Input id="demo-input-error" type="email" invalid describedBy="demo-input-error-error" />
            </twig:ui:Field>
          </div>
        </div>

        <div class="ds__block" data-recipe="textarea">
          <div class="ds__block-head"><h3 class="ds__block-title">Textarea</h3><span class="ds__block-note">ui:Textarea</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:Field id="demo-textarea" label="Note interne">
              <twig:ui:Textarea id="demo-textarea" :rows="3" />
            </twig:ui:Field>
          </div>
        </div>

        <div class="ds__block" data-recipe="select">
          <div class="ds__block-head"><h3 class="ds__block-title">Select</h3><span class="ds__block-note">ui:Select</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:Field id="demo-select" label="Etat">
              <twig:ui:Select id="demo-select" value="open" :options="[
                { value: 'open', label: 'Ouverte' },
                { value: 'done', label: 'Terminee' }
              ]" />
            </twig:ui:Field>
          </div>
        </div>

        <div class="ds__block" data-recipe="checkbox">
          <div class="ds__block-head"><h3 class="ds__block-title">Checkbox</h3><span class="ds__block-note">ui:Checkbox</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:Checkbox id="demo-check" label="Recevoir les notifications" checked />
            <twig:ui:Checkbox id="demo-check-2" label="Accepter les conditions" />
          </div>
        </div>

        <div class="ds__block" data-recipe="switch">
          <div class="ds__block-head"><h3 class="ds__block-title">Switch</h3><span class="ds__block-note">ui:Switch</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:Switch id="demo-switch" label="Theme sombre" />
            <twig:ui:Switch id="demo-switch-2" label="Notifications" checked />
          </div>
        </div>

        <div class="ds__block" data-recipe="radio-group">
          <div class="ds__block-head"><h3 class="ds__block-title">RadioGroup</h3><span class="ds__block-note">ui:RadioGroup</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:RadioGroup id="demo-radio" name="demo-radio" label="Priorite" value="normal" :options="[
              { value: 'low', label: 'Basse' },
              { value: 'normal', label: 'Normale' },
              { value: 'high', label: 'Haute' }
            ]" />
          </div>
        </div>

        <div class="ds__block" data-recipe="slider">
          <div class="ds__block-head"><h3 class="ds__block-title">Slider</h3><span class="ds__block-note">ui:Slider</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:Slider id="demo-slider" label="Volume" :value="40" />
          </div>
        </div>

        <div class="ds__block" data-recipe="date-picker">
          <div class="ds__block-head"><h3 class="ds__block-title">DatePicker</h3><span class="ds__block-note">ui:DatePicker</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:DatePicker id="demo-date" label="Date d echeance" help="Format jour mois annee" />
          </div>
        </div>

        <div class="ds__block" data-recipe="floating-label">
          <div class="ds__block-head"><h3 class="ds__block-title">FloatingLabel</h3><span class="ds__block-note">ui:FloatingLabel</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:FloatingLabel id="demo-floating" label="Adresse e-mail" type="email" />
            <twig:ui:FloatingLabel id="demo-floating-value" label="Raison sociale" value="Atelier Rivage" />
          </div>
        </div>

        <div class="ds__block" data-recipe="input-group">
          <div class="ds__block-head"><h3 class="ds__block-title">InputGroup</h3><span class="ds__block-note">ui:InputGroup</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:Field id="demo-group" label="Adresse du site">
              <twig:ui:InputGroup id="demo-group" prefix="https://" suffix=".dev" placeholder="domaine" describedBy="demo-group-help" />
            </twig:ui:Field>
          </div>
        </div>

        <div class="ds__block" data-recipe="file-upload">
          <div class="ds__block-head"><h3 class="ds__block-title">FileUpload</h3><span class="ds__block-note">ui:FileUpload</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:FileUpload id="demo-files" label="Deposer une piece" hint="PDF ou image" accept=".pdf,image/*" multiple />
          </div>
        </div>

        <div class="ds__block" data-recipe="combobox">
          <div class="ds__block-head"><h3 class="ds__block-title">Combobox</h3><span class="ds__block-note">ui:Combobox</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:Combobox id="demo-combobox" label="Mission" placeholder="Rechercher une mission" :options="[
              { value: '1', label: 'Remuneration du dirigeant' },
              { value: '2', label: 'Audit de la structure' }
            ]" />
          </div>
        </div>

        <div class="ds__block" data-recipe="input-otp">
          <div class="ds__block-head"><h3 class="ds__block-title">InputOtp</h3><span class="ds__block-note">ui:InputOtp</span></div>
          <div class="ds__specimen ds__specimen--column">
            <twig:ui:InputOtp id="demo-otp" label="Code de verification" :length="6" />
          </div>
        </div>
      </div>
    </section>

    <section class="ds__section" id="navigation">
      <h2 class="ds__section-title">Navigation</h2>
      <div class="ds__grid">
        <div class="ds__block ds__block--wide" data-recipe="navbar">
          <div class="ds__block-head"><h3 class="ds__block-title">Navbar</h3><span class="ds__block-note">ui:Navbar</span></div>
          <twig:ui:Navbar brand="Atelier Rivage" brandHref="#" toggleLabel="Ouvrir la navigation" label="Navigation principale">
            <a href="#" aria-current="page">Accueil</a>
            <a href="#">Missions</a>
            <a href="#">Documents</a>
          </twig:ui:Navbar>
        </div>

        <div class="ds__block" data-recipe="breadcrumb">
          <div class="ds__block-head"><h3 class="ds__block-title">Breadcrumb</h3><span class="ds__block-note">ui:Breadcrumb</span></div>
          <twig:ui:Breadcrumb :items="[{ label: 'Accueil', href: '#' }, { label: 'Missions', href: '#' }, { label: 'Mission 42' }]" />
        </div>

        <div class="ds__block" data-recipe="tabs">
          <div class="ds__block-head"><h3 class="ds__block-title">Tabs</h3><span class="ds__block-note">ui:Tabs</span></div>
          <twig:ui:Tabs :items="[{ label: 'En cours', href: '#', current: true }, { label: 'Terminees', href: '#' }]" />
        </div>

        <div class="ds__block" data-recipe="pagination">
          <div class="ds__block-head"><h3 class="ds__block-title">Pagination</h3><span class="ds__block-note">ui:Pagination</span></div>
          <twig:ui:Pagination :items="[{ label: '1', href: '#' }, { label: '2', href: '#', current: true }, { label: '3', href: '#' }]" :previous="{ label: 'Precedent', href: '#' }" :next="{ label: 'Suivant', href: '#' }" />
        </div>

        <div class="ds__block" data-recipe="sidebar">
          <div class="ds__block-head"><h3 class="ds__block-title">Sidebar</h3><span class="ds__block-note">ui:Sidebar</span></div>
          <twig:ui:Sidebar :items="[{ label: 'Vue d ensemble', href: '#', current: true }, { label: 'Missions', href: '#' }, { label: 'Documents', href: '#' }]" />
        </div>

        <div class="ds__block" data-recipe="navigation-menu">
          <div class="ds__block-head"><h3 class="ds__block-title">NavigationMenu</h3><span class="ds__block-note">ui:NavigationMenu</span></div>
          <twig:ui:NavigationMenu label="Sections" :items="[{ label: 'Accueil', href: '#', current: true }, { label: 'Ressources', items: [{ label: 'Guides', href: '#' }, { label: 'Modeles', href: '#' }] }]" />
        </div>

        <div class="ds__block" data-recipe="menubar">
          <div class="ds__block-head"><h3 class="ds__block-title">Menubar</h3><span class="ds__block-note">ui:Menubar</span></div>
          <twig:ui:Menubar label="Application" :items="[{ label: 'Fichier', items: [{ label: 'Nouveau', href: '#' }, { label: 'Ouvrir', href: '#' }] }, { label: 'Edition', href: '#' }]" />
        </div>

        <div class="ds__block" data-recipe="accordion">
          <div class="ds__block-head"><h3 class="ds__block-title">Accordion</h3><span class="ds__block-note">ui:Accordion</span></div>
          <twig:ui:Accordion summary="Conditions de la mission" open><p>Contenu de la section.</p></twig:ui:Accordion>
        </div>

        <div class="ds__block" data-recipe="collapsible">
          <div class="ds__block-head"><h3 class="ds__block-title">Collapsible</h3><span class="ds__block-note">ui:Collapsible</span></div>
          <twig:ui:Collapsible summary="Details techniques" open><p>Contenu repliable.</p></twig:ui:Collapsible>
        </div>

        <div class="ds__block" data-recipe="dropdown-menu">
          <div class="ds__block-head"><h3 class="ds__block-title">DropdownMenu</h3><span class="ds__block-note">ui:DropdownMenu</span></div>
          <twig:ui:DropdownMenu label="Actions" :items="[{ label: 'Ouvrir', href: '#' }, { label: 'Telecharger', href: '#' }]" />
        </div>

        <div class="ds__block" data-recipe="context-menu">
          <div class="ds__block-head"><h3 class="ds__block-title">ContextMenu</h3><span class="ds__block-note">ui:ContextMenu</span></div>
          <twig:ui:ContextMenu label="Actions" :items="[{ label: 'Ouvrir', href: '#' }, { label: 'Copier', href: '#' }]">
            <div class="ds__specimen ds__specimen--surface">Clic droit dans cette zone.</div>
          </twig:ui:ContextMenu>
        </div>

        <div class="ds__block" data-recipe="scrollspy">
          <div class="ds__block-head"><h3 class="ds__block-title">Scrollspy</h3><span class="ds__block-note">ui:Scrollspy</span></div>
          <twig:ui:Scrollspy label="Sommaire" :items="[{ id: 'section-a', label: 'Premiere section' }, { id: 'section-b', label: 'Seconde section' }]" />
        </div>
      </div>
    </section>

    <section class="ds__section" id="surfaces">
      <h2 class="ds__section-title">Surfaces</h2>
      <div class="ds__grid">
        <div class="ds__block" data-recipe="card">
          <div class="ds__block-head"><h3 class="ds__block-title">Card</h3><span class="ds__block-note">ui:Card</span></div>
          <twig:ui:Card title="Facture F-2026-010" description="Accompagnement d octobre" footer="Echeance 30 novembre">
            <p>Montant : 480,00 €</p>
          </twig:ui:Card>
        </div>

        <div class="ds__block" data-recipe="alert">
          <div class="ds__block-head"><h3 class="ds__block-title">Alert</h3><span class="ds__block-note">ui:Alert</span></div>
          <twig:ui:Alert type="success" title="Enregistre" message="La modification a ete prise en compte." />
          <twig:ui:Alert type="warning" title="Attention" message="Deux pieces manquent au dossier." />
          <twig:ui:Alert type="error" title="Echec" message="La modification n a pas pu etre enregistree." />
        </div>

        <div class="ds__block" data-recipe="dialog">
          <div class="ds__block-head"><h3 class="ds__block-title">Dialog</h3><span class="ds__block-note">ui:Dialog</span></div>
          <twig:ui:Dialog id="demo-dialog" title="Confirmer l envoi" trigger="Ouvrir le dialogue"><p>Cette action est definitive.</p></twig:ui:Dialog>
        </div>

        <div class="ds__block" data-recipe="sheet">
          <div class="ds__block-head"><h3 class="ds__block-title">Sheet</h3><span class="ds__block-note">ui:Sheet</span></div>
          <twig:ui:Sheet id="demo-sheet" title="Filtres" trigger="Ouvrir le panneau" side="right"><p>Contenu du panneau lateral.</p></twig:ui:Sheet>
        </div>

        <div class="ds__block" data-recipe="popover">
          <div class="ds__block-head"><h3 class="ds__block-title">Popover</h3><span class="ds__block-note">ui:Popover</span></div>
          <twig:ui:Popover label="Details"><p>Contenu du panneau flottant.</p></twig:ui:Popover>
        </div>

        <div class="ds__block" data-recipe="tooltip">
          <div class="ds__block-head"><h3 class="ds__block-title">Tooltip</h3><span class="ds__block-note">ui:Tooltip</span></div>
          <twig:ui:Tooltip text="Raccourci Ctrl K"><twig:ui:Icon name="search" /></twig:ui:Tooltip>
        </div>

        <div class="ds__block" data-recipe="hover-card">
          <div class="ds__block-head"><h3 class="ds__block-title">HoverCard</h3><span class="ds__block-note">ui:HoverCard</span></div>
          <twig:ui:HoverCard label="Camille Martin"><p>Interlocutrice sur trois missions. Repond sous 24 heures.</p></twig:ui:HoverCard>
        </div>

        <div class="ds__block" data-recipe="toast">
          <div class="ds__block-head"><h3 class="ds__block-title">Toast</h3><span class="ds__block-note">ui:Toast</span></div>
          <twig:ui:Toast id="demo-toast" type="success" title="Enregistre" message="La modification a ete prise en compte." />
        </div>

        <div class="ds__block" data-recipe="confirm-dialog">
          <div class="ds__block-head"><h3 class="ds__block-title">ConfirmDialog</h3><span class="ds__block-note">ui:ConfirmDialog</span></div>
          <twig:ui:ConfirmDialog id="demo-confirm" title="Supprimer la mission" message="Cette action est definitive." trigger="Supprimer" confirmLabel="Supprimer" cancelLabel="Annuler" />
        </div>

        <div class="ds__block" data-recipe="resizable">
          <div class="ds__block-head"><h3 class="ds__block-title">Resizable</h3><span class="ds__block-note">ui:Resizable</span></div>
          <twig:ui:Resizable label="Redimensionner le panneau"><p>Panneau redimensionnable.</p></twig:ui:Resizable>
        </div>
      </div>
    </section>

    <section class="ds__section" id="donnees">
      <h2 class="ds__section-title">Donnees</h2>
      <div class="ds__grid">
        <div class="ds__block ds__block--wide" data-recipe="table">
          <div class="ds__block-head"><h3 class="ds__block-title">Table</h3><span class="ds__block-note">ui:Table</span></div>
          <twig:ui:Table caption="Factures">
            <thead><tr><th scope="col">Numero</th><th scope="col">Objet</th><th scope="col" class="ui-table__num">Montant</th></tr></thead>
            <tbody>
              <tr><td>F-2026-010</td><td>Accompagnement d octobre</td><td class="ui-table__num">480,00</td></tr>
              <tr><td>F-2026-009</td><td>Audit de structure</td><td class="ui-table__num">1 250,00</td></tr>
            </tbody>
          </twig:ui:Table>
        </div>

        <div class="ds__block" data-recipe="list-group">
          <div class="ds__block-head"><h3 class="ds__block-title">ListGroup</h3><span class="ds__block-note">ui:ListGroup</span></div>
          <twig:ui:ListGroup :items="[{ label: 'Synthese', href: '#', meta: '26 oct.' }, { label: 'Lettre de mission', meta: '24 oct.' }]" />
        </div>

        <div class="ds__block" data-recipe="description-list">
          <div class="ds__block-head"><h3 class="ds__block-title">DescriptionList</h3><span class="ds__block-note">ui:DescriptionList</span></div>
          <twig:ui:DescriptionList :items="[{ term: 'Numero', description: 'F-2026-010' }, { term: 'Echeance', description: '30 novembre 2026' }]" />
        </div>

        <div class="ds__block" data-recipe="stat">
          <div class="ds__block-head"><h3 class="ds__block-title">Stat</h3><span class="ds__block-note">ui:Stat</span></div>
          <twig:ui:Stat label="Missions en cours" value="4" hint="Deux attendent votre geste" trend="up" />
        </div>

        <div class="ds__block" data-recipe="progress">
          <div class="ds__block-head"><h3 class="ds__block-title">Progress</h3><span class="ds__block-note">ui:Progress</span></div>
          <twig:ui:Progress :value="60" label="Avancement" showValue />
        </div>

        <div class="ds__block" data-recipe="badge">
          <div class="ds__block-head"><h3 class="ds__block-title">Badge</h3><span class="ds__block-note">ui:Badge</span></div>
          <div class="ds__specimen">
            <twig:ui:Badge tone="success">Valide</twig:ui:Badge>
            <twig:ui:Badge tone="danger" variant="solid">En retard</twig:ui:Badge>
            <twig:ui:Badge tone="info" variant="outline">Information</twig:ui:Badge>
            <twig:ui:Badge tone="warning">En attente</twig:ui:Badge>
          </div>
        </div>

        <div class="ds__block" data-recipe="avatar">
          <div class="ds__block-head"><h3 class="ds__block-title">Avatar</h3><span class="ds__block-note">ui:Avatar</span></div>
          <div class="ds__specimen">
            <twig:ui:Avatar initials="CM" label="Camille Martin" />
            <twig:ui:Avatar initials="AR" label="Atelier Rivage" size="lg" />
          </div>
        </div>

        <div class="ds__block" data-recipe="timeline">
          <div class="ds__block-head"><h3 class="ds__block-title">Timeline</h3><span class="ds__block-note">ui:Timeline</span></div>
          <twig:ui:Timeline :items="[{ date: '26 octobre 2026', title: 'Document recu', description: 'Synthese de votre situation' }, { date: '24 octobre 2026', title: 'Mission ouverte', description: 'Remuneration du dirigeant' }]" />
        </div>

        <div class="ds__block" data-recipe="empty-state">
          <div class="ds__block-head"><h3 class="ds__block-title">EmptyState</h3><span class="ds__block-note">ui:EmptyState</span></div>
          <twig:ui:EmptyState title="Aucune mission" message="Creez une mission pour commencer." />
        </div>

        <div class="ds__block" data-recipe="skeleton">
          <div class="ds__block-head"><h3 class="ds__block-title">Skeleton</h3><span class="ds__block-note">ui:Skeleton</span></div>
          <twig:ui:Skeleton :rows="2" />
        </div>

        <div class="ds__block" data-recipe="chart">
          <div class="ds__block-head"><h3 class="ds__block-title">Chart</h3><span class="ds__block-note">ui:Chart</span></div>
          <twig:ui:Chart label="Missions par mois" :values="[3, 5, 4, 7]" :labels="['Jan', 'Fev', 'Mar', 'Avr']" />
        </div>

        <div class="ds__block" data-recipe="calendar">
          <div class="ds__block-head"><h3 class="ds__block-title">Calendar</h3><span class="ds__block-note">ui:Calendar</span></div>
          <twig:ui:Calendar label="Novembre 2026" month="Novembre 2026" previousLabel="Octobre" nextLabel="Decembre" previous="#" next="#" :days="[{ label: '', empty: true }, { label: '1', href: '#', selected: true }, { label: '2', href: '#' }, { label: '3', href: '#' }, { label: '4', href: '#', disabled: true }, { label: '5', href: '#' }]" />
        </div>
      </div>
    </section>

    <section class="ds__section" id="mise-en-page">
      <h2 class="ds__section-title">Mise en page</h2>
      <div class="ds__grid">
        <div class="ds__block ds__block--wide" data-recipe="container">
          <div class="ds__block-head"><h3 class="ds__block-title">Container, Grid, Stack</h3><span class="ds__block-note">ui:Container · ui:Grid · ui:Stack</span></div>
          <p class="ds__lead">Trois utilitaires nommes remplacent les centaines de classes de mise en page d un framework CSS. Container borne la largeur de lecture, Grid place des colonnes, Stack espace une suite d elements. Ils ne dessinent rien : ils organisent.</p>
          <twig:ui:Container size="md">
            <twig:ui:Grid :columns="3" :gap="3">
              <div class="ds__specimen ds__specimen--surface">Colonne 1</div>
              <div class="ds__specimen ds__specimen--surface">Colonne 2</div>
              <div class="ds__specimen ds__specimen--surface">Colonne 3</div>
            </twig:ui:Grid>
          </twig:ui:Container>
          <twig:ui:Stack direction="horizontal" :gap="2" align="center">
            <twig:ui:Icon name="calendar" />
            <span>Stack horizontal, elements espaces et alignes.</span>
          </twig:ui:Stack>
        </div>
      </div>
    </section>

    <section class="ds__section" id="avances">
      <h2 class="ds__section-title">Composants avances</h2>
      <div class="ds__grid">
        <div class="ds__block" data-recipe="command">
          <div class="ds__block-head"><h3 class="ds__block-title">Command</h3><span class="ds__block-note">ui:Command</span></div>
          <twig:ui:Command trigger="Ouvrir la palette" label="Commandes" placeholder="Rechercher" :items="[{ label: 'Voir les missions', href: '#' }, { label: 'Voir les documents', href: '#' }]" />
        </div>

        <div class="ds__block" data-recipe="carousel">
          <div class="ds__block-head"><h3 class="ds__block-title">Carousel</h3><span class="ds__block-note">ui:Carousel</span></div>
          <twig:ui:Carousel label="Pieces jointes" previousLabel="Precedent" nextLabel="Suivant">
            <div class="ds__specimen ds__specimen--surface">Premiere piece</div>
            <div class="ds__specimen ds__specimen--surface">Deuxieme piece</div>
          </twig:ui:Carousel>
        </div>

        <div class="ds__block" data-recipe="code-block">
          <div class="ds__block-head"><h3 class="ds__block-title">CodeBlock</h3><span class="ds__block-note">ui:CodeBlock</span></div>
          <twig:ui:CodeBlock label="Installation" language="shell" code="php bin/console ux:install button --kit guilloche" />
        </div>

        <div class="ds__block" data-recipe="marker">
          <div class="ds__block-head"><h3 class="ds__block-title">Marker</h3><span class="ds__block-note">ui:Marker</span></div>
          <p>La mission <twig:ui:Marker>Remuneration du dirigeant</twig:ui:Marker> est a votre tour.</p>
        </div>

        <div class="ds__block" data-recipe="aspect-ratio">
          <div class="ds__block-head"><h3 class="ds__block-title">AspectRatio</h3><span class="ds__block-note">ui:AspectRatio</span></div>
          <twig:ui:AspectRatio ratio="16/9"><div class="ds__specimen ds__specimen--surface">Media 16:9</div></twig:ui:AspectRatio>
        </div>

        <div class="ds__block" data-recipe="separator">
          <div class="ds__block-head"><h3 class="ds__block-title">Separator</h3><span class="ds__block-note">ui:Separator</span></div>
          <twig:ui:Separator label="Ou" />
        </div>

        <div class="ds__block" data-recipe="direction">
          <div class="ds__block-head"><h3 class="ds__block-title">Direction</h3><span class="ds__block-note">ui:Direction</span></div>
          <twig:ui:Direction dir="rtl"><p>Contenu en sens inverse.</p></twig:ui:Direction>
        </div>

        <div class="ds__block" data-recipe="scroll-area">
          <div class="ds__block-head"><h3 class="ds__block-title">ScrollArea</h3><span class="ds__block-note">ui:ScrollArea</span></div>
          <twig:ui:ScrollArea maxHeight="8rem" label="Historique"><p>Ligne 1</p><p>Ligne 2</p><p>Ligne 3</p><p>Ligne 4</p><p>Ligne 5</p><p>Ligne 6</p><p>Ligne 7</p></twig:ui:ScrollArea>
        </div>
      </div>
    </section>

    <section class="ds__section" id="en-situation">
      <h2 class="ds__section-title">En situation</h2>

      <div class="ds__block ds__block--wide">
        <div class="ds__block-head"><h3 class="ds__block-title">Formulaire de mission</h3><span class="ds__block-note">composition</span></div>
        <twig:ui:PageHeader title="Nouvelle mission" description="Renseignez la mission et son interlocuteur." headingLevel="3">
          <twig:ui:Button intent="secondary">Annuler</twig:ui:Button>
          <twig:ui:Button>Enregistrer</twig:ui:Button>
        </twig:ui:PageHeader>
        <twig:ui:FormSection title="Identite" description="Informations de la structure">
          <twig:ui:Grid :columns="2" :gap="4">
            <twig:ui:Field id="mission-name" label="Nom de la mission" required>
              <twig:ui:Input id="mission-name" required />
            </twig:ui:Field>
            <twig:ui:Field id="mission-type" label="Type">
              <twig:ui:Select id="mission-type" :options="[{ value: 'remu', label: 'Remuneration' }, { value: 'audit', label: 'Audit' }]" />
            </twig:ui:Field>
          </twig:ui:Grid>
          <twig:ui:Field id="mission-note" label="Note">
            <twig:ui:Textarea id="mission-note" :rows="3" />
          </twig:ui:Field>
        </twig:ui:FormSection>
      </div>

      <div class="ds__block ds__block--wide">
        <div class="ds__block-head"><h3 class="ds__block-title">Liste et detail</h3><span class="ds__block-note">composition</span></div>
        <twig:ui:DetailLayout label="Missions">
          {% block list %}
            <twig:ui:ListGroup :items="[{ label: 'Remuneration du dirigeant', href: '#', meta: '75 %' }, { label: 'Audit de la structure', href: '#', meta: '45 %' }, { label: 'Organisation du groupe', href: '#', meta: '20 %' }]" />
          {% endblock %}
          {% block detail %}
            <twig:ui:Card title="Remuneration du dirigeant" description="Prochaine etape : valider la synthese" footer="Interlocuteur : Camille Martin">
              <twig:ui:Progress :value="75" label="Avancement" showValue />
            </twig:ui:Card>
          {% endblock %}
        </twig:ui:DetailLayout>
      </div>
    </section>

    <div id="section-a"><h2 class="ds__section-title">Premiere section</h2><p>Contenu A.</p></div>
    <div id="section-b"><h2 class="ds__section-title">Seconde section</h2><p>Contenu B.</p></div>
  </main>
</div>
{% endblock %}
