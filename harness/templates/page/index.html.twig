{% extends 'base.html.twig' %}

{% block title %}Harnais de contrat du kit Guilloche{% endblock %}

{% block body %}
  <main class="page ui-scope">
    <h1>Guilloche - harnais de contrat</h1>
    <p>Chaque recette du kit est rendue ici avec des donnees neutres. <code>bin/sync-harness</code> copie templates, controleurs et styles depuis <code>kits/guilloche</code>.</p>

    <section data-recipe="button">
      <h2>Button</h2>
      <twig:ui:Button intent="primary" size="lg">Action principale</twig:ui:Button>
      <twig:ui:Button appearance="ghost">Action secondaire</twig:ui:Button>
      <twig:ui:Button loading>Enregistrement</twig:ui:Button>
    </section>

    <section data-recipe="icon">
      <h2>Icon</h2>
      <twig:ui:Icon name="search" />
      <twig:ui:Icon name="alert" :size="16" />
    </section>

    <section data-recipe="badge">
      <h2>Badge</h2>
      <twig:ui:Badge tone="success">Valide</twig:ui:Badge>
      <twig:ui:Badge tone="danger" variant="solid">En retard</twig:ui:Badge>
      <twig:ui:Badge tone="info" variant="outline">Information</twig:ui:Badge>
    </section>

    <section data-recipe="card">
      <h2>Card</h2>
      <twig:ui:Card title="Titre de carte" description="Description courte" footer="Pied de carte">
        <p>Corps de la carte.</p>
      </twig:ui:Card>
    </section>

    <section data-recipe="separator">
      <h2>Separator</h2>
      <twig:ui:Separator label="Ou" />
    </section>

    <section data-recipe="skeleton">
      <h2>Skeleton</h2>
      <twig:ui:Skeleton :rows="2" />
    </section>

    <section data-recipe="kbd">
      <h2>Kbd</h2>
      <twig:ui:Kbd>Ctrl</twig:ui:Kbd> + <twig:ui:Kbd>K</twig:ui:Kbd>
    </section>

    <section data-recipe="alert">
      <h2>Alert</h2>
      <twig:ui:Alert type="success" title="Enregistre" message="La modification a ete prise en compte." />
      <twig:ui:Alert type="error" title="Echec" message="La modification n'a pas pu etre enregistree." />
    </section>

    <section data-recipe="avatar">
      <h2>Avatar</h2>
      <twig:ui:Avatar initials="CM" label="Camille Martin" />
      <twig:ui:Avatar initials="AR" label="Atelier Rivage" size="lg" />
    </section>

    <section data-recipe="progress">
      <h2>Progress</h2>
      <twig:ui:Progress :value="60" label="Avancement" showValue />
    </section>

    <section data-recipe="field">
      <h2>Field, Input</h2>
      <twig:ui:Field id="demo-input" label="Rechercher" help="Nom ou categorie" required>
        <twig:ui:Input id="demo-input" describedBy="demo-input-help" required />
      </twig:ui:Field>
    </section>

    <section data-recipe="textarea">
      <h2>Textarea</h2>
      <twig:ui:Field id="demo-textarea" label="Note">
        <twig:ui:Textarea id="demo-textarea" :rows="3" />
      </twig:ui:Field>
    </section>

    <section data-recipe="select">
      <h2>Select</h2>
      <twig:ui:Field id="demo-select" label="Etat">
        <twig:ui:Select id="demo-select" value="open" :options="[
          { value: 'open', label: 'Ouverte' },
          { value: 'done', label: 'Terminee' }
        ]" />
      </twig:ui:Field>
    </section>

    <section data-recipe="checkbox">
      <h2>Checkbox</h2>
      <twig:ui:Checkbox id="demo-check" label="Recevoir les notifications" checked />
    </section>

    <section data-recipe="switch">
      <h2>Switch</h2>
      <twig:ui:Switch id="demo-switch" label="Theme sombre" />
    </section>

    <section data-recipe="breadcrumb">
      <h2>Breadcrumb</h2>
      <twig:ui:Breadcrumb :items="[
        { label: 'Accueil', href: '#' },
        { label: 'Missions', href: '#' },
        { label: 'Mission 42' }
      ]" />
    </section>

    <section data-recipe="pagination">
      <h2>Pagination</h2>
      <twig:ui:Pagination :items="[
        { label: '1', href: '#' },
        { label: '2', href: '#', current: true },
        { label: '3', href: '#' }
      ]" :previous="{ label: 'Precedent', href: '#' }" :next="{ label: 'Suivant', href: '#' }" />
    </section>

    <section data-recipe="toggle">
      <h2>Toggle</h2>
      <twig:ui:Toggle :pressed="true">Favoris</twig:ui:Toggle>
      <twig:ui:Toggle>Archive</twig:ui:Toggle>
    </section>

    <section data-recipe="accordion">
      <h2>Accordion</h2>
      <twig:ui:Accordion summary="Conditions de la mission" open>
        <p>Contenu de la section.</p>
      </twig:ui:Accordion>
    </section>

    <section data-recipe="tabs">
      <h2>Tabs</h2>
      <twig:ui:Tabs :items="[
        { label: 'En cours', href: '#', current: true },
        { label: 'Terminees', href: '#' }
      ]" />
    </section>

    <section data-recipe="dialog">
      <h2>Dialog</h2>
      <twig:ui:Dialog id="demo-dialog" title="Confirmer l'envoi" trigger="Ouvrir le dialogue">
        <p>Cette action est definitive.</p>
      </twig:ui:Dialog>
    </section>

    <section data-recipe="sheet">
      <h2>Sheet</h2>
      <twig:ui:Sheet id="demo-sheet" title="Filtres" trigger="Ouvrir le panneau" side="right">
        <p>Contenu du panneau lateral.</p>
      </twig:ui:Sheet>
    </section>

    <section data-recipe="tooltip">
      <h2>Tooltip</h2>
      <twig:ui:Tooltip text="Raccourci Ctrl K">
        <twig:ui:Icon name="search" />
      </twig:ui:Tooltip>
    </section>
  </main>
{% endblock %}
