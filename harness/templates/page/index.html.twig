{% extends 'base.html.twig' %}

{% block title %}Harnais de contrat du kit Guilloche{% endblock %}

{% block body %}
  <main class="page ui-scope">
    <h1>Guilloche - harnais de contrat</h1>
    <p>Chaque recette du kit est rendue ici avec des donnees neutres. <code>bin/sync-harness</code> copie templates, controleurs et styles depuis <code>kits/guilloche</code>.</p>

    <section data-recipe="button">
      <h2>Button</h2>
      <twig:ui:Button intent="primary" size="lg">Action principale</twig:ui:Button>
      <twig:ui:Button appearance="ghost">Action secondaire</twig:ui:Button>
      <twig:ui:Button loading>Enregistrement</twig:ui:Button>
    </section>

    <section data-recipe="icon">
      <h2>Icon</h2>
      <twig:ui:Icon name="search" />
      <twig:ui:Icon name="alert" :size="16" />
    </section>

    <section data-recipe="badge">
      <h2>Badge</h2>
      <twig:ui:Badge tone="success">Valide</twig:ui:Badge>
      <twig:ui:Badge tone="danger" variant="solid">En retard</twig:ui:Badge>
      <twig:ui:Badge tone="info" variant="outline">Information</twig:ui:Badge>
    </section>

    <section data-recipe="card">
      <h2>Card</h2>
      <twig:ui:Card title="Titre de carte" description="Description courte" footer="Pied de carte">
        <p>Corps de la carte.</p>
      </twig:ui:Card>
    </section>

    <section data-recipe="separator">
      <h2>Separator</h2>
      <twig:ui:Separator label="Ou" />
    </section>

    <section data-recipe="skeleton">
      <h2>Skeleton</h2>
      <twig:ui:Skeleton :rows="2" />
    </section>

    <section data-recipe="kbd">
      <h2>Kbd</h2>
      <twig:ui:Kbd>Ctrl</twig:ui:Kbd> + <twig:ui:Kbd>K</twig:ui:Kbd>
    </section>

    <section data-recipe="alert">
      <h2>Alert</h2>
      <twig:ui:Alert type="success" title="Enregistre" message="La modification a ete prise en compte." />
      <twig:ui:Alert type="error" title="Echec" message="La modification n'a pas pu etre enregistree." />
    </section>

    <section data-recipe="avatar">
      <h2>Avatar</h2>
      <twig:ui:Avatar initials="CM" label="Camille Martin" />
      <twig:ui:Avatar initials="AR" label="Atelier Rivage" size="lg" />
    </section>

    <section data-recipe="progress">
      <h2>Progress</h2>
      <twig:ui:Progress :value="60" label="Avancement" showValue />
    </section>

    <section data-recipe="field">
      <h2>Field, Input</h2>
      <twig:ui:Field id="demo-input" label="Rechercher" help="Nom ou categorie" required>
        <twig:ui:Input id="demo-input" describedBy="demo-input-help" required />
      </twig:ui:Field>
    </section>

    <section data-recipe="textarea">
      <h2>Textarea</h2>
      <twig:ui:Field id="demo-textarea" label="Note">
        <twig:ui:Textarea id="demo-textarea" :rows="3" />
      </twig:ui:Field>
    </section>

    <section data-recipe="select">
      <h2>Select</h2>
      <twig:ui:Field id="demo-select" label="Etat">
        <twig:ui:Select id="demo-select" value="open" :options="[
          { value: 'open', label: 'Ouverte' },
          { value: 'done', label: 'Terminee' }
        ]" />
      </twig:ui:Field>
    </section>

    <section data-recipe="checkbox">
      <h2>Checkbox</h2>
      <twig:ui:Checkbox id="demo-check" label="Recevoir les notifications" checked />
    </section>

    <section data-recipe="switch">
      <h2>Switch</h2>
      <twig:ui:Switch id="demo-switch" label="Theme sombre" />
    </section>

    <section data-recipe="breadcrumb">
      <h2>Breadcrumb</h2>
      <twig:ui:Breadcrumb :items="[
        { label: 'Accueil', href: '#' },
        { label: 'Missions', href: '#' },
        { label: 'Mission 42' }
      ]" />
    </section>

    <section data-recipe="pagination">
      <h2>Pagination</h2>
      <twig:ui:Pagination :items="[
        { label: '1', href: '#' },
        { label: '2', href: '#', current: true },
        { label: '3', href: '#' }
      ]" :previous="{ label: 'Precedent', href: '#' }" :next="{ label: 'Suivant', href: '#' }" />
    </section>

    <section data-recipe="toggle">
      <h2>Toggle</h2>
      <twig:ui:Toggle :pressed="true">Favoris</twig:ui:Toggle>
      <twig:ui:Toggle>Archive</twig:ui:Toggle>
    </section>

    <section data-recipe="accordion">
      <h2>Accordion</h2>
      <twig:ui:Accordion summary="Conditions de la mission" open>
        <p>Contenu de la section.</p>
      </twig:ui:Accordion>
    </section>

    <section data-recipe="tabs">
      <h2>Tabs</h2>
      <twig:ui:Tabs :items="[
        { label: 'En cours', href: '#', current: true },
        { label: 'Terminees', href: '#' }
      ]" />
    </section>

    <section data-recipe="dialog">
      <h2>Dialog</h2>
      <twig:ui:Dialog id="demo-dialog" title="Confirmer l'envoi" trigger="Ouvrir le dialogue">
        <p>Cette action est definitive.</p>
      </twig:ui:Dialog>
    </section>

    <section data-recipe="sheet">
      <h2>Sheet</h2>
      <twig:ui:Sheet id="demo-sheet" title="Filtres" trigger="Ouvrir le panneau" side="right">
        <p>Contenu du panneau lateral.</p>
      </twig:ui:Sheet>
    </section>

    <section data-recipe="tooltip">
      <h2>Tooltip</h2>
      <twig:ui:Tooltip text="Raccourci Ctrl K">
        <twig:ui:Icon name="search" />
      </twig:ui:Tooltip>
    </section>

    <section data-recipe="table">
      <h2>Table</h2>
      <twig:ui:Table caption="Factures">
        <thead><tr><th scope="col">Numero</th><th scope="col" class="ui-table__num">Montant</th></tr></thead>
        <tbody><tr><td>F-2026-010</td><td class="ui-table__num">480,00</td></tr></tbody>
      </twig:ui:Table>
    </section>

    <section data-recipe="description-list">
      <h2>DescriptionList</h2>
      <twig:ui:DescriptionList :items="[
        { term: 'Numero', description: 'F-2026-010' },
        { term: 'Echeance', description: '30 novembre 2026' }
      ]" />
    </section>

    <section data-recipe="stat">
      <h2>Stat</h2>
      <twig:ui:Stat label="Missions en cours" value="4" hint="Deux attendent votre geste" trend="up" />
    </section>

    <section data-recipe="empty-state">
      <h2>EmptyState</h2>
      <twig:ui:EmptyState title="Aucune mission" message="Creez une mission pour commencer." />
    </section>

    <section data-recipe="radio-group">
      <h2>RadioGroup</h2>
      <twig:ui:RadioGroup id="demo-radio" name="demo-radio" label="Priorite" value="normal" :options="[
        { value: 'low', label: 'Basse' },
        { value: 'normal', label: 'Normale' },
        { value: 'high', label: 'Haute' }
      ]" />
    </section>

    <section data-recipe="slider">
      <h2>Slider</h2>
      <twig:ui:Slider id="demo-slider" label="Volume" :value="40" />
    </section>

    <section data-recipe="timeline">
      <h2>Timeline</h2>
      <twig:ui:Timeline :items="[
        { date: '26 octobre 2026', title: 'Document recu', description: 'Synthese de votre situation' },
        { date: '24 octobre 2026', title: 'Mission ouverte', description: 'Remuneration du dirigeant' }
      ]" />
    </section>

    <section data-recipe="toast">
      <h2>Toast</h2>
      <twig:ui:Toast id="demo-toast" type="success" title="Enregistre" message="La modification a ete prise en compte." />
    </section>

    <section data-recipe="dropdown-menu">
      <h2>DropdownMenu</h2>
      <twig:ui:DropdownMenu label="Actions" :items="[
        { label: 'Ouvrir', href: '#' },
        { label: 'Telecharger', href: '#' }
      ]" />
    </section>

    <section data-recipe="popover">
      <h2>Popover</h2>
      <twig:ui:Popover label="Details">
        <p>Contenu du panneau flottant.</p>
      </twig:ui:Popover>
    </section>

    <section data-recipe="page-header">
      <h2>PageHeader</h2>
      <twig:ui:PageHeader title="Missions" description="Suivi des dossiers en cours">
        <twig:ui:Button>Nouvelle mission</twig:ui:Button>
      </twig:ui:PageHeader>
    </section>

    <section data-recipe="filter-bar">
      <h2>FilterBar</h2>
      <twig:ui:FilterBar action="#" submitLabel="Filtrer">
        <twig:ui:Field id="demo-filter" label="Recherche">
          <twig:ui:Input id="demo-filter" name="q" type="search" />
        </twig:ui:Field>
      </twig:ui:FilterBar>
    </section>

    <section data-recipe="form-section">
      <h2>FormSection</h2>
      <twig:ui:FormSection title="Identite" description="Informations de la structure">
        <twig:ui:Field id="demo-section" label="Raison sociale">
          <twig:ui:Input id="demo-section" />
        </twig:ui:Field>
      </twig:ui:FormSection>
    </section>

    <section data-recipe="detail-layout">
      <h2>DetailLayout</h2>
      <twig:ui:DetailLayout label="Missions">
        {% block list %}<p>Liste des missions</p>{% endblock %}
        {% block detail %}<p>Detail de la mission</p>{% endblock %}
      </twig:ui:DetailLayout>
    </section>

    <section data-recipe="sidebar">
      <h2>Sidebar</h2>
      <twig:ui:Sidebar :items="[
        { label: 'Vue d ensemble', href: '#', current: true },
        { label: 'Missions', href: '#' },
        { label: 'Documents', href: '#' }
      ]" />
    </section>

    <section data-recipe="confirm-dialog">
      <h2>ConfirmDialog</h2>
      <twig:ui:ConfirmDialog id="demo-confirm" title="Supprimer la mission" message="Cette action est definitive." trigger="Supprimer" confirmLabel="Supprimer" cancelLabel="Annuler" />
    </section>

    <section data-recipe="data-region">
      <h2>DataRegion</h2>
      <twig:ui:DataRegion state="loading" loadingMessage="Chargement des missions...">
        <p>Resultats precedents conserves.</p>
      </twig:ui:DataRegion>
    </section>

    <section data-recipe="date-picker">
      <h2>DatePicker</h2>
      <twig:ui:DatePicker id="demo-date" label="Date d echeance" help="Format jour mois annee" />
    </section>

    <section data-recipe="file-upload">
      <h2>FileUpload</h2>
      <twig:ui:FileUpload id="demo-files" label="Deposer une piece" hint="PDF ou image" accept=".pdf,image/*" multiple />
    </section>

    <section data-recipe="combobox">
      <h2>Combobox</h2>
      <twig:ui:Combobox id="demo-combobox" label="Mission" placeholder="Rechercher une mission" :options="[
        { value: '1', label: 'Remuneration du dirigeant' },
        { value: '2', label: 'Audit de la structure' }
      ]" />
    </section>

    <section data-recipe="command">
      <h2>Command</h2>
      <twig:ui:Command trigger="Ouvrir la palette" label="Commandes" placeholder="Rechercher" :items="[
        { label: 'Voir les missions', href: '#' },
        { label: 'Voir les documents', href: '#' }
      ]" />
    </section>

    <section data-recipe="carousel">
      <h2>Carousel</h2>
      <twig:ui:Carousel label="Pieces jointes" previousLabel="Precedent" nextLabel="Suivant">
        <div class="ui-card"><div class="ui-card__body">Premiere piece</div></div>
        <div class="ui-card"><div class="ui-card__body">Deuxieme piece</div></div>
      </twig:ui:Carousel>
    </section>

    <section data-recipe="chart">
      <h2>Chart</h2>
      <twig:ui:Chart label="Missions par mois" :values="[3, 5, 4, 7]" :labels="['Jan', 'Fev', 'Mar', 'Avr']" />
    </section>

    <section data-recipe="button-group">
      <h2>ButtonGroup</h2>
      <twig:ui:ButtonGroup label="Alignement">
        <twig:ui:Button appearance="secondary">Gauche</twig:ui:Button>
        <twig:ui:Button appearance="secondary">Centre</twig:ui:Button>
        <twig:ui:Button appearance="secondary">Droite</twig:ui:Button>
      </twig:ui:ButtonGroup>
    </section>

    <section data-recipe="toggle-group">
      <h2>ToggleGroup</h2>
      <twig:ui:ToggleGroup label="Affichage">
        <twig:ui:Toggle :pressed="true">Liste</twig:ui:Toggle>
        <twig:ui:Toggle>Grille</twig:ui:Toggle>
      </twig:ui:ToggleGroup>
    </section>

    <section data-recipe="spinner">
      <h2>Spinner</h2>
      <twig:ui:Spinner label="Chargement" />
      <twig:ui:Spinner size="lg" />
    </section>

    <section data-recipe="collapsible">
      <h2>Collapsible</h2>
      <twig:ui:Collapsible summary="Details techniques" open>
        <p>Contenu repliable.</p>
      </twig:ui:Collapsible>
    </section>

    <section data-recipe="list-group">
      <h2>ListGroup</h2>
      <twig:ui:ListGroup :items="[
        { label: 'Synthese', href: '#', meta: '26 oct.' },
        { label: 'Lettre de mission', meta: '24 oct.' }
      ]" />
    </section>

    <section data-recipe="aspect-ratio">
      <h2>AspectRatio</h2>
      <twig:ui:AspectRatio ratio="16/9">
        <div class="ui-card"><div class="ui-card__body">Media 16:9</div></div>
      </twig:ui:AspectRatio>
    </section>

    <section data-recipe="input-group">
      <h2>InputGroup</h2>
      <twig:ui:Field id="demo-group" label="Recherche">
        <twig:ui:InputGroup id="demo-group" prefix="https://" suffix=".dev" placeholder="domaine" describedBy="demo-group-help" />
      </twig:ui:Field>
    </section>

    <section data-recipe="code-block">
      <h2>CodeBlock</h2>
      <twig:ui:CodeBlock label="Commande" language="shell" code="php bin/console ux:install button --kit guilloche" />
    </section>

    <section data-recipe="marker">
      <h2>Marker</h2>
      <p>La mission <twig:ui:Marker>Remuneration du dirigeant</twig:ui:Marker> est a votre tour.</p>
    </section>

    <section data-recipe="navbar">
      <h2>Navbar</h2>
      <twig:ui:Navbar brand="Guilloche" brandHref="#" toggleLabel="Ouvrir la navigation" label="Navigation principale">
        <a href="#" aria-current="page">Accueil</a>
        <a href="#">Missions</a>
        <a href="#">Documents</a>
      </twig:ui:Navbar>
    </section>

    <section data-recipe="navigation-menu">
      <h2>NavigationMenu</h2>
      <twig:ui:NavigationMenu label="Sections" :items="[
        { label: 'Accueil', href: '#', current: true },
        { label: 'Ressources', items: [{ label: 'Guides', href: '#' }, { label: 'Modeles', href: '#' }] }
      ]" />
    </section>

    <section data-recipe="menubar">
      <h2>Menubar</h2>
      <twig:ui:Menubar label="Application" :items="[
        { label: 'Fichier', items: [{ label: 'Nouveau', href: '#' }, { label: 'Ouvrir', href: '#' }] },
        { label: 'Edition', href: '#' }
      ]" />
    </section>

    <section data-recipe="hover-card">
      <h2>HoverCard</h2>
      <twig:ui:HoverCard label="Camille Martin">
        <p>Interlocutrice sur trois missions. Repond sous 24 heures.</p>
      </twig:ui:HoverCard>
    </section>

    <section data-recipe="scroll-area">
      <h2>ScrollArea</h2>
      <twig:ui:ScrollArea maxHeight="8rem" label="Historique">
        <p>Ligne 1</p><p>Ligne 2</p><p>Ligne 3</p><p>Ligne 4</p><p>Ligne 5</p><p>Ligne 6</p><p>Ligne 7</p>
      </twig:ui:ScrollArea>
    </section>

    <section data-recipe="direction">
      <h2>Direction</h2>
      <twig:ui:Direction dir="rtl">
        <p>Contenu en sens inverse.</p>
      </twig:ui:Direction>
    </section>

    <section data-recipe="context-menu">
      <h2>ContextMenu</h2>
      <twig:ui:ContextMenu label="Actions" :items="[{ label: 'Ouvrir', href: '#' }, { label: 'Copier', href: '#' }]">
        <p>Clic droit dans cette zone.</p>
      </twig:ui:ContextMenu>
    </section>

    <section data-recipe="resizable">
      <h2>Resizable</h2>
      <twig:ui:Resizable label="Redimensionner le panneau">
        <p>Panneau redimensionnable.</p>
      </twig:ui:Resizable>
    </section>

    <section data-recipe="calendar">
      <h2>Calendar</h2>
      <twig:ui:Calendar label="Novembre 2026" month="Novembre 2026"
        previousLabel="Octobre" nextLabel="Decembre"
        previous="#" next="#"
        :days="[
          { label: '', empty: true }, { label: '1', href: '#', selected: true },
          { label: '2', href: '#' }, { label: '3', href: '#' },
          { label: '4', href: '#', disabled: true }, { label: '5', href: '#' }
        ]" />
    </section>

    <section data-recipe="input-otp">
      <h2>InputOtp</h2>
      <twig:ui:InputOtp id="demo-otp" label="Code de verification" :length="6" />
    </section>
  </main>
{% endblock %}
