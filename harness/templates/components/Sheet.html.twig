{# Ui:Sheet — panneau lateral modal. Meme contrat que Ui:Dialog, mais ancre au
   bord. side : right|left. Le panneau est un dialogue natif, donc le focus et
   Echap restent geres par le navigateur. #}
{% props id, title, trigger = null, description = null, side = 'right' %}
<div class="ui-sheet-root" data-controller="ui--sheet">
  {% if trigger %}
    <button class="ui-sheet__trigger" type="button" data-action="ui--sheet#open">{{ trigger }}</button>
  {% endif %}
  <dialog class="ui-sheet ui-sheet--{{ side }}" id="{{ id }}" data-ui--sheet-target="dialog" data-action="click->ui--sheet#backdrop">
    <div class="ui-sheet__panel">
      <header class="ui-sheet__header">
        <div>
          <h2 class="ui-sheet__title">{{ title }}</h2>
          {% if description %}<p class="ui-sheet__description">{{ description }}</p>{% endif %}
        </div>
        <button class="ui-sheet__close" type="button" data-action="ui--sheet#close" aria-label="Close">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m6.5 6.5 11 11M6.5 17.5l11-11"/></svg>
        </button>
      </header>
      <div class="ui-sheet__body">{% block content %}{% endblock %}</div>
    </div>
  </dialog>
</div>
