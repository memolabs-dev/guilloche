{# Ui:Tabs — onglets de navigation. items : liste de { label, href, current }.
   Chaque onglet est un lien : l'etat vient de l'URL, donc aucun JavaScript et
   le retour arriere du navigateur fonctionne. aria-current marque l'onglet actif. #}
{% props items = [], label = 'Tabs' %}
<nav {{ attributes.defaults({ class: 'ui-tabs', 'aria-label': label }) }}>
  <ul class="ui-tabs__list" role="tablist">
    {% for item in items %}
      <li role="presentation">
        <a class="ui-tabs__tab{{ item.current|default(false) ? ' is-current' : '' }}"
           role="tab"
           href="{{ item.href ?? '#' }}"
           {{ item.current|default(false) ? 'aria-current="page"' }}>
          {{ item.label }}
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>
