{# Ui:Accordion — section repliable native. Utilise details/summary : ouverture,
   clavier et annonce fonctionnent sans JavaScript. summary est le titre,
   le slot est le contenu. open affiche la section ouverte au chargement. #}
{% props summary, open = false %}
<details {{ attributes.defaults({ class: 'ui-accordion' }) }} {{ open ? 'open' }}>
  <summary class="ui-accordion__summary">
    <span class="ui-accordion__title">{{ summary }}</span>
    <svg class="ui-accordion__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9.5 6 6 6-6"/></svg>
  </summary>
  <div class="ui-accordion__content">{% block content %}{% endblock %}</div>
</details>
