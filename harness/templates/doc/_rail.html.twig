{% set labels = {
  fondation: 'Fondations',
  primitives: 'Primitives',
  formulaires: 'Formulaires',
  navigation: 'Navigation et surfaces',
  donnees: 'Donnees',
  patterns: 'Patterns d ecran',
  avances: 'Composants avances',
  layout: 'Mise en page'
} %}
<aside class="ds__rail">
  <a class="ds__brand" href="{{ path('app_home') }}">guilloché<span>.</span></a>
  <p class="ds__version">design system · 1.10.0</p>
  <button class="ds__theme" type="button" data-doc-theme aria-label="Changer de theme">Contraste</button>
  <nav class="ds__nav" aria-label="Composants">
    <a class="ds__nav-home" href="{{ path('app_home') }}">Catalogue</a>
    {% for family, items in families %}
      <p class="ds__nav-family">{{ labels[family] ?? family }}</p>
      {% for item in items %}
        <a href="{{ path('app_recipe', { recipe: item.name }) }}">{{ item.title }}</a>
      {% endfor %}
    {% endfor %}
  </nav>
</aside>
