{% import 'doc/_macros.html.twig' as m %}
<div class="ds__example">
  <div class="ds__example-head"><h3 class="ds__example-title">Validé et en attente</h3></div>
  <div class="ds__example-render ds__example-render--column ds__example-render--compact">
    <twig:ui:Seal text="Validé par vous" by="guillaume" at="2026-10-12T10:30:00" atLabel="12 oct." />
    <twig:ui:Seal text="Signé par C. Martin" by="camille" at="2026-10-14T09:00:00" atLabel="14 oct." />
    <twig:ui:Seal text="En attente de votre validation" by="guillaume" state="pending" />
  </div>
  {{ m.code('<twig:ui:Seal text="Validé par vous" by="guillaume" at="2026-10-12" atLabel="12 oct." :path="guilloche_seal_path(\'guillaume\')" />') }}
</div>

<div class="ds__example">
  <div class="ds__example-head"><h3 class="ds__example-title">Sceau fraîchement posé</h3></div>
  <div class="ds__example-render ds__example-render--compact">
    <twig:ui:Seal text="Validé à l'instant" by="guillaume" fresh />
  </div>
  {{ m.code('<twig:ui:Seal text="Validé à l\'instant" by="guillaume" fresh :path="guilloche_seal_path(\'guillaume\')" />') }}
</div>

<div class="ds__example">
  <div class="ds__example-head"><h3 class="ds__example-title">Liste de propositions</h3></div>
  <div class="ds__example-render ds__example-render--column">
    <div class="ui-list-group">
      <div class="ui-list-group__item"><span>Critère de jugement principal</span><twig:ui:Seal text="Validé par vous" by="guillaume" /></div>
      <div class="ui-list-group__item"><span>Critère secondaire</span><twig:ui:Seal text="En attente" by="guillaume" state="pending" /></div>
      <div class="ui-list-group__item"><span>Population de l'étude</span><twig:ui:Seal text="En attente" by="camille" state="pending" /></div>
    </div>
  </div>
  {{ m.code('<twig:ui:Seal text="En attente" by="guillaume" state="pending" :path="guilloche_seal_path(\'guillaume\')" />') }}
</div>
