{% import 'doc/_macros.html.twig' as m %}
<div class="ds__example">
  <div class="ds__example-head"><h3 class="ds__example-title">Une signature reconnaissable</h3></div>
  <div class="ds__example-render ds__rosette-intro">
    <div class="ds__rosette-hero">
      <div class="ds__rosette-hero-mark"><twig:ui:Rosette seed="AR-2026-042" :size="64" label="Empreinte de la mission AR-2026-042" /></div>
      <div class="ds__rosette-hero-text">
        <span class="ds__rosette-kicker">EMPREINTE DÉTERMINISTE</span>
        <h4>Chaque dossier a sa signature.</h4>
        <p>Une même référence produit toujours le même tracé. Un motif discret pour identifier, suivre et retrouver un dossier.</p>
        <code>AR-2026-042</code>
      </div>
    </div>
    <div class="ds__rosette-scale" aria-label="Aperçus de taille de la même rosette">
      <figure><twig:ui:Rosette seed="AR-2026-042" :size="16" /><figcaption>16 px</figcaption></figure>
      <figure><twig:ui:Rosette seed="AR-2026-042" :size="20" /><figcaption>20 px</figcaption></figure>
      <figure><twig:ui:Rosette seed="AR-2026-042" :size="24" /><figcaption>24 px</figcaption></figure>
      <figure><twig:ui:Rosette seed="AR-2026-042" :size="32" /><figcaption>32 px</figcaption></figure>
      <figure><twig:ui:Rosette seed="AR-2026-042" :size="40" /><figcaption>40 px</figcaption></figure>
    </div>
  </div>
  {{ m.code('<twig:ui:Rosette seed="AR-2026-042" :size="64" label="Empreinte de la mission" />') }}
</div>

<div class="ds__example">
  <div class="ds__example-head"><h3 class="ds__example-title">Un tracé qui accompagne l’avancement</h3></div>
  <div class="ds__example-render ds__rosette-progress-grid">
    <figure class="ds__rosette-state"><twig:ui:Rosette seed="AR-2026-042" :size="40" :progress="25" label="Avancement 25 %" /><figcaption><strong>25 %</strong><span>En préparation</span></figcaption></figure>
    <figure class="ds__rosette-state"><twig:ui:Rosette seed="AR-2026-042" :size="40" :progress="60" label="Avancement 60 %" /><figcaption><strong>60 %</strong><span>En cours</span></figcaption></figure>
    <figure class="ds__rosette-state"><twig:ui:Rosette seed="AR-2026-042" :size="40" :progress="100" label="Terminé" /><figcaption><strong>100 %</strong><span>Terminé</span></figcaption></figure>
    <figure class="ds__rosette-state"><twig:ui:Rosette seed="AR-2026-042" :size="32" loading label="Chargement" /><figcaption><strong>—</strong><span>Chargement</span></figcaption></figure>
  </div>
  {{ m.code('<twig:ui:Rosette seed="AR-2026-042" :progress="60" label="Avancement 60 %" />') }}
</div>

