<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{% block title %}Guilloche, design system{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('fonts.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/app.scss') }}" />
    <script src="{{ asset('doc.js') }}" defer></script>
    {{ importmap('app') }}
  </head>
  <body class="ui-scope">
    {% include 'doc/_topbar.html.twig' %}
    <div class="ds">
      {% include 'doc/_rail.html.twig' %}
      <main class="ds__main">{% block body %}{% endblock %}</main>
    </div>
  </body>
</html>
