{% extends 'doc/base.html.twig' %}

{% block title %}{{ item.title }} · Guilloche{% endblock %}

{% block body %}
  <nav class="ds__crumbs" aria-label="Fil d'Ariane">
    <a href="{{ path('app_home') }}">Catalogue</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ item.title }}</span>
  </nav>

  <header class="ds__header">
    <h1 class="ds__title">{{ item.title }}</h1>
    <p class="ds__lead">{{ item.description }}</p>
    <div class="ds__actions">
      <a class="ui-button ui-button--secondary ui-button--sm" href="https://github.com/memolabs-dev/guilloche/tree/main/kits/guilloche/{{ item.name }}">Voir la source</a>
      <button class="ui-button ui-button--secondary ui-button--sm" type="button" data-copy-page>Copier la page en Markdown</button>
    </div>
    <p class="ds__meta">
      <span class="ui-badge ui-badge--neutral ui-badge--soft">{{ item.family }}</span>
      <span class="ui-badge ui-badge--neutral ui-badge--outline">v{{ item.version }}</span>
      <span class="ds__mono">ui:{{ item.title }}</span>
    </p>
  </header>

  <div class="ds__layout">
    <div class="ds__content" data-doc="{{ item.name }}">
      <section class="ds__section" id="exemples">
        <h2 class="ds__section-title">Exemples</h2>
        <div class="ds__examples">
          {% if item.hasExamples %}
            {% include 'doc/specimens/' ~ item.name ~ '.html.twig' %}
          {% else %}
            <div class="ds__example">
              <div class="ds__example-head"><h3 class="ds__example-title">Aperçu</h3></div>
              <div class="ds__example-render">
                {% include 'doc/previews/' ~ item.name ~ '.html.twig' ignore missing %}
              </div>
              {% if item.code %}
                <div class="ds__example-code"><pre><code>{{ item.code }}</code></pre></div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </section>

  <section class="ds__section" id="props">
    <h2 class="ds__section-title">Props</h2>
    {% if item.propsTable %}
      <div class="ds__table-wrap">
        <table class="ui-table">
          <thead><tr><th scope="col">Prop</th><th scope="col">Défaut</th><th scope="col">Rôle</th></tr></thead>
          <tbody>
            {% for row in item.propsTable %}
              <tr><td><code>{{ row.name }}</code></td><td><code>{{ row.default }}</code></td><td>{{ row.role }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% elseif item.props %}
      <div class="ds__table-wrap">
        <table class="ui-table">
          <thead><tr><th scope="col">Prop</th></tr></thead>
          <tbody>
            {% for prop in item.props %}
              <tr><td><code>{{ prop }}</code></td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p>Aucune prop : le composant prend son contenu par le slot.</p>
    {% endif %}
  </section>

  <section class="ds__section" id="accessibilite">
    <h2 class="ds__section-title">Accessibilité</h2>
    <p class="ds__lead">Le détail est dans le README de la recette : rôles, clavier, noms accessibles et états. Le test de contrat verifie que chaque champ a un libellé, que les rôles sont renseignés et que les SVG sont nommés ou masqués.</p>
  </section>

      <nav class="ds__pager" aria-label="Pagination de la documentation">
        {% if item.previous %}<a href="{{ path('app_recipe', { recipe: item.previous.name }) }}">&larr; {{ item.previous.title }}</a>{% else %}<span></span>{% endif %}
        {% if item.next %}<a href="{{ path('app_recipe', { recipe: item.next.name }) }}">{{ item.next.title }} &rarr;</a>{% else %}<span></span>{% endif %}
      </nav>
    </div>

    <aside class="ds__toc" aria-label="Sur cette page">
      <p>Sur cette page</p>
      <a href="#exemples">Exemples</a>
      <a href="#props">Props</a>
      <a href="#accessibilite">Accessibilité</a>
    </aside>
  </div>
  <template id="doc-scss">{{ item.scss }}</template>
{% endblock %}
